# Copy to .env. Everything has a working local default.
DATABASE_URL=postgresql://finrag:finrag@127.0.0.1:5436/finrag
EMBED_MODEL=models/bge-base-fiqa      # falls back to BASE_EMBED_MODEL until trained
BASE_EMBED_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
FT_RERANK_MODEL=models/reranker-fiqa  # only for the +rerank-ft comparison
FINRAG_DEVICE=auto            # auto -> mps / cuda / cpu

LLM_PROVIDER=ollama           # or groq
LLM_MODEL=qwen3:8b            # groq: llama-3.3-70b-versatile
JUDGE_MODEL=qwen3:14b
OLLAMA_URL=http://127.0.0.1:11434
GROQ_API_KEY=
